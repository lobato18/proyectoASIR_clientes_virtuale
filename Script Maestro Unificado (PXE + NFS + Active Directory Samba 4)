#!/bin/bash
# ============================================================
# PROVISIÓN CORREGIDA PARA PROYECTO TECNOLOBATO
# ============================================================

# 1. CORRECCIÓN DE IDENTIDAD (Vital para Samba)
hostnamectl set-hostname servidor
echo "127.0.1.1 servidor.tecnolobato.local servidor" >> /etc/hosts

# 2. INSTALACIÓN DE PAQUETES
apt update
DEBIAN_FRONTEND=noninteractive apt install -y samba krb5-config krb5-user smbclient \
debootstrap nfs-kernel-server tftpd-hpa pxelinux syslinux-common syslinux-efi

# 3. PROVISIÓN AD DC (Limpia)
systemctl stop smbd nmbd winbind samba-ad-dc 2>/dev/null
[ -f /etc/samba/smb.conf ] && mv /etc/samba/smb.conf /etc/samba/smb.conf.bak
rm -rf /var/lib/samba/private/*

samba-tool domain provision \
  --server-role=dc --use-rfc2307 --dns-backend=SAMBA_INTERNAL \
  --realm=TECNOLOBATO.LOCAL --domain=TECNOLOBATO \
  --adminpass='TecnoLobato2026!'

cp /var/lib/samba/private/krb5.conf /etc/krb5.conf
systemctl unmask samba-ad-dc
systemctl start samba-ad-dc

# 4. CREACIÓN THIN CLIENT (Con montajes de seguridad)
mkdir -p /export/thinclient
debootstrap --arch=amd64 bookworm /export/thinclient http://deb.debian.org/debian/

# Montajes para que el Kernel se instale bien
mount --bind /dev /export/thinclient/dev
mount --bind /proc /export/thinclient/proc
mount --bind /sys /export/thinclient/sys

chroot /export/thinclient /bin/bash <<EOF
apt update
apt install -y linux-image-amd64 nfs-common
exit
EOF

# Desmontar después de la instalación
umount /export/thinclient/dev /export/thinclient/proc /export/thinclient/sys

# 5. CONFIGURACIÓN PXE FINAL
mkdir -p /var/lib/tftpboot/pxelinux.cfg
cp /usr/lib/PXELINUX/pxelinux.0 /var/lib/tftpboot/
cp /usr/lib/syslinux/modules/bios/ldlinux.c32 /var/lib/tftpboot/
cp /export/thinclient/boot/vmlinuz-* /var/lib/tftpboot/vmlinuz
cp /export/thinclient/boot/initrd.img-* /var/lib/tftpboot/initrd.img

# Configurar el menú apuntando a la IP correcta
cat <<EOT > /var/lib/tftpboot/pxelinux.cfg/default
DEFAULT thinclient
LABEL thinclient
    KERNEL vmlinuz
    APPEND initrd=initrd.img root=/dev/nfs nfsroot=192.168.1.163:/export/thinclient rw ip=dhcp
EOT

systemctl restart nfs-kernel-server tftpd-hpa isc-dhcp-server
echo "✅ PROCESO COMPLETADO SIN ERRORES"
